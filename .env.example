# Copy to .env and set the required values. Do not commit .env.
DATABASE_URL=postgresql+psycopg://imm:imm@localhost:5432/imm
SESSION_SECRET=replace-with-a-long-random-string
OPERATOR_PASSWORD=replace-with-a-local-password

# Required before Settings -> API integrations can save Groww or OpenAI credentials.
# Generate a Fernet key and keep it only in this file:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATIONS_SECRET_KEY=

# Must stay false until a later milestone explicitly enables live orders.
LIVE_ORDER_SERVER_FLAG=false

WEB_ORIGIN=http://localhost:3000

# Out-of-band entry halt (no database needed). Entries halt while this file exists.
# IMM_HALT_FILE=var/run/HALT
# Optional hardware input: a file holding the switch level (e.g. /sys/class/gpio/gpio17/value).
# Entries halt when its value equals IMM_HALT_GPIO_ACTIVE, or when it cannot be read.
# IMM_HALT_GPIO_PATH=
# IMM_HALT_GPIO_ACTIVE=1
LOG_LEVEL=INFO
